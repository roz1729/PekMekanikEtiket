@model PekMekanikEtiket.Models.EtiketModel

<div class="container mt-4">
    <h3 class="mb-4">Etiket Oluştur</h3>
    <form id="etiketForm">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Parça Kodu</label>
                <input type="text" name="ParcaKodu" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Parça Adı</label>
                <input type="text" name="ParcaAdi" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Adet</label>
                <input type="number" id="adet" name="Adet" class="form-control" value="1" min="1" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Koli Sayısı</label>
                <input type="number" id="koliSayisi" name="KoliSayisi" class="form-control" value="1" min="1" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Dil</label>
                <select name="Dil" class="form-select">
                    <option value="Türkçe">Türkçe</option>
                    <option value="English">English</option>
                    <option value="Deutsch">Deutsch</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Etiket Tipi</label>
                <select id="etiketTipi" name="EtiketTipi" class="form-select">
                    <option value="Küçük">Küçük (99x38 mm)</option>
                    <option value="Büyük">Büyük (210x99 mm)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Sipariş No</label>
                <input name="SiparisNo" class="form-control" placeholder="Sipariş No" />
            </div>
            <div class="col-md-3 d-flex align-items-end pb-2">
                <div class="form-check">
                    <input type="checkbox" id="logoGoster" class="form-check-input" checked />
                    <label class="form-check-label">Logo Göster</label>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Fotoğraf</label>
                <select id="fotografSecim" name="FotografSecim" class="form-select" onchange="fotografSecimDegisti()">
                    <option value="yok">Yok</option>
                    <option value="ayni">Tüm Koliler Aynı</option>
                    <option value="ayri">Her Koliye Ayrı</option>
                </select>
            </div>
            <div class="col-md-4" id="ayniYukle" style="display:none;">
                <label class="form-label">Fotoğraf Yükle</label>
                <input type="file" id="ayniResim" accept="image/*" class="form-control" />
            </div>
        </div>

        <div class="mt-3" id="koliGrid"></div>
        <input type="hidden" name="LayoutJson" id="layoutJson" />
        <input type="hidden" name="KoliLayoutlariJson" id="koliLayoutlariJson" />

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-secondary" onclick="duzenleAc()">✏️ Düzenle</button>
            <button type="button" class="btn btn-primary" onclick="onizleAc()"> Önizle</button>
            <button type="button" class="btn btn-success" onclick="pdfIndir()">📄 PDF İndir</button>
        </div>
    </form>
</div>

<!-- Önizle Modal -->
<div class="modal fade" id="onizleModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Önizleme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalIcerik" style="overflow-x:auto;"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="yazdir()">🖨 Yazdır</button>
                <button type="button" class="btn btn-success" onclick="pdfIndir()">📄 PDF İndir</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Düzenle Modal -->
<div class="modal fade" id="duzenleModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Etiket Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" id="duzenleIcerik" style="overflow:auto;"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="duzenleKaydet()">💾 Kaydet</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/etiket.js"></script>
}
